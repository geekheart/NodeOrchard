{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HDK planning input",
  "type": "object",
  "additionalProperties": false,
  "required": ["productCode", "hardwareVersion", "releaseDate", "sourceProject"],
  "properties": {
    "productCode": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"},
    "hardwareVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$", "description": "不含 V 前缀的字符串，不转换为数字，例如 1.0、12.10。"},
    "releaseDate": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "sourceProject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "documentSummary"],
      "properties": {
        "fileName": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^/\\\\]+\\.epro2$"},
        "documentSummary": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    }
  }
}
