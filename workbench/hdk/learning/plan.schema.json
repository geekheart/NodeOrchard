{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HDK export plan (planning only)",
  "type": "object",
  "additionalProperties": false,
  "required": ["packageName", "paths", "supplementalDirectories", "checks"],
  "$defs": {
    "relativePath": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\u0000]+$"}
  },
  "properties": {
    "packageName": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*_HDK_V[0-9]+\\.[0-9]+$"},
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "schematicPdf", "bom", "gerber", "topPaste", "bottomPaste", "pickPlace", "silkscreenPdf", "outlineDxf", "processXlsx"],
      "properties": {
        "project": {"$ref": "#/$defs/relativePath"},
        "schematicPdf": {"$ref": "#/$defs/relativePath"},
        "bom": {"$ref": "#/$defs/relativePath"},
        "gerber": {"$ref": "#/$defs/relativePath"},
        "topPaste": {"$ref": "#/$defs/relativePath"},
        "bottomPaste": {"$ref": "#/$defs/relativePath"},
        "pickPlace": {"$ref": "#/$defs/relativePath"},
        "silkscreenPdf": {"$ref": "#/$defs/relativePath"},
        "outlineDxf": {"$ref": "#/$defs/relativePath"},
        "processXlsx": {"$ref": "#/$defs/relativePath"}
      }
    },
    "supplementalDirectories": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/relativePath"}},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stencilFromCurrentGerber", "checkDocumentReferences", "excludeOsMetadata", "exportFromInputOnly"],
      "properties": {
        "stencilFromCurrentGerber": {"const": true},
        "checkDocumentReferences": {"const": true},
        "excludeOsMetadata": {"const": true},
        "exportFromInputOnly": {"const": true}
      }
    }
  }
}
