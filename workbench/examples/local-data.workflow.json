{
  "schemaVersion": 2,
  "id": "workflow-example-local-data",
  "title": "本地数据 · 工具与代码",
  "mode": "execute",
  "settings": {
    "maxConcurrency": 2,
    "outputDirectory": ""
  },
  "nodes": [
    {
      "id": "local-input",
      "type": "input",
      "title": "输入 JSON 文本",
      "x": 40,
      "y": 100,
      "config": {
        "outputType": "text",
        "fieldName": "input",
        "required": true,
        "trigger": "manual",
        "schedule": "09:00",
        "timezone": "Asia/Shanghai",
        "defaultValue": "  {\"title\":\"本地数据演示\",\"items\":[{\"name\":\"读取输入\"},{\"name\":\"检查结果\"}],\"enabled\":false,\"count\":0,\"empty\":[]}  "
      }
    },
    {
      "id": "local-trim",
      "type": "tool",
      "title": "清理首尾空白",
      "x": 360,
      "y": 100,
      "config": {
        "inputType": "text",
        "outputType": "text",
        "executionMode": "tool",
        "toolName": "text.trim",
        "language": "javascript",
        "code": "",
        "timeoutSeconds": 120,
        "failurePolicy": "stop"
      }
    },
    {
      "id": "local-parse",
      "type": "tool",
      "title": "解析 JSON",
      "x": 680,
      "y": 100,
      "config": {
        "inputType": "text",
        "outputType": "any",
        "executionMode": "tool",
        "toolName": "json.parse",
        "language": "javascript",
        "code": "",
        "timeoutSeconds": 120,
        "failurePolicy": "stop"
      }
    },
    {
      "id": "local-js",
      "type": "tool",
      "title": "JavaScript · 统计条目",
      "x": 1000,
      "y": 100,
      "config": {
        "inputType": "object",
        "outputType": "object",
        "executionMode": "code",
        "toolName": "",
        "language": "javascript",
        "code": "console.log('收到条目', input.items.length);\nreturn { ...input, itemCount: input.items.length };",
        "timeoutSeconds": 120,
        "failurePolicy": "stop"
      }
    },
    {
      "id": "local-verify",
      "type": "tool",
      "title": "JavaScript · 保留原始值",
      "x": 1320,
      "y": 100,
      "config": {
        "inputType": "object",
        "outputType": "object",
        "executionMode": "code",
        "toolName": "",
        "language": "javascript",
        "code": "console.log('保留 false、0 和空数组');\nreturn { ...input, checked: true };",
        "timeoutSeconds": 120,
        "failurePolicy": "stop"
      }
    },
    {
      "id": "local-output",
      "type": "output",
      "title": "输出结果",
      "x": 1640,
      "y": 100,
      "config": {
        "inputType": "any",
        "fileName": "local-data-result.json",
        "stage": "final"
      },
      "ports": {
        "inputs": [
          {
            "id": "in",
            "label": "输入",
            "type": "any",
            "required": true
          }
        ],
        "outputs": [
          {
            "id": "out",
            "label": "成果",
            "type": "any"
          },
          {
            "id": "learning",
            "label": "学习产物",
            "type": "any"
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "id": "edge-0",
      "sourceNode": "local-input",
      "sourcePort": "out",
      "targetNode": "local-trim",
      "targetPort": "in"
    },
    {
      "id": "edge-1",
      "sourceNode": "local-trim",
      "sourcePort": "out",
      "targetNode": "local-parse",
      "targetPort": "in"
    },
    {
      "id": "edge-2",
      "sourceNode": "local-parse",
      "sourcePort": "out",
      "targetNode": "local-js",
      "targetPort": "in"
    },
    {
      "id": "edge-3",
      "sourceNode": "local-js",
      "sourcePort": "out",
      "targetNode": "local-verify",
      "targetPort": "in"
    },
    {
      "id": "edge-4",
      "sourceNode": "local-verify",
      "sourcePort": "out",
      "targetNode": "local-output",
      "targetPort": "in"
    }
  ],
  "viewport": {
    "x": 12,
    "y": 18,
    "zoom": 0.5
  }
}
