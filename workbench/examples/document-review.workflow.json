{
  "schemaVersion": 2,
  "id": "workflow-example-document-review",
  "title": "文档整理 · 本地字段与条件分支",
  "mode": "execute",
  "settings": {
    "maxConcurrency": 2,
    "outputDirectory": ""
  },
  "nodes": [
    {
      "id": "sample-input",
      "type": "input",
      "title": "内置演示文字",
      "x": 40,
      "y": 180,
      "config": {
        "outputType": "text",
        "fieldName": "document",
        "required": true,
        "trigger": "manual",
        "schedule": "09:00",
        "timezone": "Asia/Shanghai",
        "defaultValue": "标题：本地资料演示\n负责人：示例负责人\n事项：核对资料；确认交付\n备注：所有内容都是安全的内置演示数据。"
      }
    },
    {
      "id": "sample-extract",
      "type": "tool",
      "title": "本地提取字段",
      "x": 350,
      "y": 180,
      "config": {
        "inputType": "text",
        "outputType": "object",
        "executionMode": "code",
        "toolName": "",
        "language": "javascript",
        "code": "const fields = Object.fromEntries(input.split(/\\r?\\n/).filter(line => line.includes('：')).map(line => { const at = line.indexOf('：'); return [line.slice(0, at).trim(), line.slice(at + 1).trim()]; }));\nreturn { title: fields['标题'] || '', owner: fields['负责人'] || '', items: (fields['事项'] || '').split('；').filter(Boolean), complete: Boolean(fields['标题'] && fields['负责人']) };",
        "timeoutSeconds": 120,
        "failurePolicy": "stop"
      }
    },
    {
      "id": "sample-check",
      "type": "condition",
      "title": "资料是否完整",
      "x": 660,
      "y": 180,
      "config": {
        "inputType": "object",
        "outputType": "object",
        "expression": "input.complete === true"
      }
    },
    {
      "id": "sample-output",
      "type": "output",
      "title": "保存完整资料",
      "x": 970,
      "y": 80,
      "config": {
        "inputType": "any",
        "fileName": "summary.json",
        "stage": "final"
      },
      "ports": {
        "inputs": [
          {
            "id": "in",
            "label": "输入",
            "type": "any",
            "required": true
          }
        ],
        "outputs": [
          {
            "id": "out",
            "label": "成果",
            "type": "any"
          },
          {
            "id": "learning",
            "label": "学习产物",
            "type": "any"
          }
        ]
      }
    },
    {
      "id": "sample-human",
      "type": "human",
      "title": "核对缺失资料",
      "x": 660,
      "y": 430,
      "config": {
        "inputType": "object",
        "outputType": "object",
        "prompt": "演示文字缺少标题或负责人时会停在这里。请核对演示数据后确认；不连接任何外部服务。"
      }
    },
    {
      "id": "sample-reviewed",
      "type": "output",
      "title": "保存核对结果",
      "x": 970,
      "y": 430,
      "config": {
        "inputType": "any",
        "fileName": "reviewed.json",
        "stage": "final"
      },
      "ports": {
        "inputs": [
          {
            "id": "in",
            "label": "输入",
            "type": "any",
            "required": true
          }
        ],
        "outputs": [
          {
            "id": "out",
            "label": "成果",
            "type": "any"
          },
          {
            "id": "learning",
            "label": "学习产物",
            "type": "any"
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "id": "edge-e9e01720-5aa8-45e4-8a53-6a223cfdcb7d",
      "sourceNode": "sample-input",
      "sourcePort": "out",
      "targetNode": "sample-extract",
      "targetPort": "in"
    },
    {
      "id": "edge-43d64627-09a1-4633-8947-033ec2c5dbd4",
      "sourceNode": "sample-extract",
      "sourcePort": "out",
      "targetNode": "sample-check",
      "targetPort": "in"
    },
    {
      "id": "edge-6e4d9a2c-6b87-47b7-932f-7fcd1673b29d",
      "sourceNode": "sample-check",
      "sourcePort": "yes",
      "targetNode": "sample-output",
      "targetPort": "in"
    },
    {
      "id": "edge-69c62180-3c6a-47a9-86f5-2fd9afad3dcd",
      "sourceNode": "sample-check",
      "sourcePort": "no",
      "targetNode": "sample-human",
      "targetPort": "in"
    },
    {
      "id": "edge-1ba68a64-4042-4d97-92f0-4c6d4f6dd4ea",
      "sourceNode": "sample-human",
      "sourcePort": "out",
      "targetNode": "sample-reviewed",
      "targetPort": "in"
    }
  ],
  "viewport": {
    "x": 0,
    "y": 0,
    "zoom": 1
  }
}
